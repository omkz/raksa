# App
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# GitHub App (optional until GitHub integration is used)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_PRIVATE_KEY=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28

# Nebius Token Factory (optional; demo works without it)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# Tavily security research (optional)
TAVILY_API_KEY=

# Sandbox provider: demo | docker | nebius
SANDBOX_PROVIDER=demo
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
NEBIUS_PROJECT=
SANDBOX_TIMEOUT_SECONDS=180
SANDBOX_MAX_ARCHIVE_BYTES=8388608

# Repository/workflow limits
MAX_REPOSITORY_FILES=60
MAX_FILE_BYTES=180000
MAX_REPOSITORY_BYTES=1200000
MAX_FINDINGS=10

# Database & Worker Queue (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://raksa:raksa@localhost:5432/raksa
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_HEARTBEAT_INTERVAL_SECONDS=5.0
WORKER_STALE_TIMEOUT_SECONDS=180
WORKER_MAX_ATTEMPTS=3
