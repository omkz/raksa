# Build on Linux amd64: docker build -f ops/Dockerfile.opengrep -t raksa-opengrep:v1.30.0 .
FROM debian:bookworm-slim
ARG OPENGREP_VERSION=v1.30.0
ARG OPENGREP_SHA256=35779bdd72e92129c8df2a77f0c55e8c08356801ea92591ef32108d6b28d564c
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fLSs --retry 3 -o /usr/local/bin/opengrep \
       "https://github.com/opengrep/opengrep/releases/download/${OPENGREP_VERSION}/opengrep_manylinux_x86" \
    && echo "${OPENGREP_SHA256}  /usr/local/bin/opengrep" | sha256sum -c - \
    && chmod +x /usr/local/bin/opengrep
ENTRYPOINT ["opengrep"]
